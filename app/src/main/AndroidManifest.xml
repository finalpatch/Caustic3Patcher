<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <queries><package android:name="com.singlecellsoftware.caustic"/></queries>
    <application android:label="@string/app_name" android:icon="@drawable/ic_patcher" android:theme="@style/AppTheme" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <service android:name=".PatchService" android:exported="false" android:foregroundServiceType="dataSync"/>
        <provider android:name=".ApkProvider" android:authorities="org.caustic.patcher.apk" android:exported="false" android:grantUriPermissions="true"/>
    </application>
</manifest>
